{
  "name": "LoungeSession",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short shareable code used by Connect sessions"
    },
    "name": {
      "type": "string",
      "default": "",
      "description": "Display name for the Connect session"
    },
    "host_id": {
      "type": "string"
    },
    "host_name": {
      "type": "string",
      "default": ""
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "join_approval_mode": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual"
    },
    "skip_request_id": {
      "type": "number",
      "default": 0
    },
    "skip_requested_by": {
      "type": "string",
      "default": ""
    },
    "skip_requested_at": {
      "type": "string",
      "default": ""
    },
    "current_track_id": {
      "type": "string",
      "default": ""
    },
    "current_track": {
      "type": "string",
      "default": ""
    },
    "position_seconds": {
      "type": "number",
      "default": 0
    },
    "is_playing": {
      "type": "boolean",
      "default": false
    },
    "sync_anchor_at": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "code",
    "host_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}