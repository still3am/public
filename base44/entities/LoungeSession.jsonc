{
  "name": "LoungeSession",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short shareable code used in the QR link"
    },
    "name": {
      "type": "string",
      "default": "",
      "description": "Display name for the lounge; falls back to \"{host_name} Lounge\" when empty"
    },
    "host_id": {
      "type": "string"
    },
    "host_name": {
      "type": "string",
      "default": ""
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "current_track_id": {
      "type": "string",
      "default": ""
    },
    "current_track": {
      "type": "string",
      "default": "",
      "description": "JSON-serialized minimal track object the host is currently playing"
    },
    "position_seconds": {
      "type": "number",
      "default": 0
    },
    "is_playing": {
      "type": "boolean",
      "default": false
    },
    "sync_anchor_at": {
      "type": "string",
      "default": "",
      "description": "ISO timestamp recorded at the moment position_seconds was sampled"
    }
  },
  "required": [
    "code",
    "host_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
