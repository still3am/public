{
  "name": "SavedPlaylist",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user who saved the playlist into their library"
    },
    "playlist_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "playlist_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "is_blocked": false
          }
        }
      ]
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "is_blocked": false
          }
        }
      ]
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
