{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string",
      "description": "The user doing the following"
    },
    "following_id": {
      "type": "string",
      "description": "Id of the row being followed \u2014 a User id, or an Artist record id when target_type is \"artist\""
    },
    "target_type": {
      "type": "string",
      "enum": [
        "user",
        "artist"
      ],
      "default": "user",
      "description": "What following_id points at. Rows written before this field existed have no value and are read as \"user\"."
    },
    "artist_name": {
      "type": "string",
      "default": "",
      "description": "Display name kept alongside an artist follow, so the follow survives a rename of the Artist record"
    }
  },
  "required": [
    "follower_id",
    "following_id"
  ],
  "rls": {
    "create": {
      "data.follower_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}