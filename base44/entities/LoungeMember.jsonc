{
  "name": "LoungeMember",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "avatar_url": {
      "type": "string",
      "default": ""
    },
    "role": {
      "type": "string",
      "enum": [
        "host",
        "guest"
      ],
      "default": "guest"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "session_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
