{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string",
      "default": "",
      "description": "Display name kept alongside the report so the admin queue reads without extra lookups"
    },
    "kind": {
      "type": "string",
      "enum": [
        "track",
        "bug"
      ],
      "default": "track",
      "description": "track = something wrong with a song; bug = a problem with the app itself"
    },
    "track_id": {
      "type": "string",
      "default": "",
      "description": "Empty for a bug report \u2014 only track reports point at a song"
    },
    "page": {
      "type": "string",
      "default": "",
      "description": "Route the reporter was on when the bug happened"
    },
    "reason": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "reporter_id",
    "reason"
  ],
  "rls": {
    "create": {
      "data.reporter_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}