{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "reporter_id",
    "track_id",
    "reason"
  ]
}