{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed"
      ],
      "default": "pending"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "track",
        "user",
        "comment",
        "annotation",
        "suggestion",
        "notification",
        "artist",
        "moment",
        "moment_comment"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string",
      "default": ""
    },
    "moment_id": {
      "type": "string"
    }
  },
  "required": [
    "reporter_id",
    "reason"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
