{
  "name": "Album",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "cover_art_url": {
      "type": "string",
      "default": ""
    },
    "creator_id": {
      "type": "string"
    },
    "artisan": {
      "type": "string",
      "default": ""
    },
    "genre": {
      "type": "string",
      "enum": [
        "Pop",
        "Hip-Hop",
        "R&B",
        "Soul",
        "Funk",
        "Dance",
        "Electronic",
        "Techno",
        "House",
        "Trap",
        "Disco",
        "Rock",
        "Alternative",
        "Indie",
        "Punk",
        "Metal",
        "Country",
        "Folk",
        "Blues",
        "Jazz",
        "Classical",
        "Ambient",
        "Reggae",
        "Latin",
        "World",
        "K-Pop",
        "J-Pop",
        "Singer/Songwriter",
        "Soundtrack",
        "Easy Listening",
        "Holiday",
        "Christian & Gospel",
        "Children's Music",
        "Comedy",
        "Spoken Word",
        "Fitness & Workout",
        "Other"
      ],
      "default": "Other"
    },
    "description": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "title",
    "creator_id"
  ],
  "rls": {
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}