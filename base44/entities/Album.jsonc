  "Jazz",
  "Classical",
  "Ambient",
  "Reggae",
  "Latin",
  "World",
  "K-Pop",
  "J-Pop",
  "Singer/Songwriter",
  "Soundtrack",
  "Easy Listening",
  "Holiday",
  "Christian & Gospel",
  "Children's Music",
  "Comedy",
  "Spoken Word",
  "Fitness & Workout",
  "Sexy Drill",
  "Drill",
  "New York Drill",
  "Brooklyn Drill",
  "UK Drill",
  "Chicago Drill",
  "Sample Drill",
  "Jersey Club",
  "Baltimore Club",
  "Philly Club",
  "Rap",
  "Boom Bap",
  "Alternative Hip-Hop",
  "Conscious Hip-Hop",
  "Cloud Rap",
  "Emo Rap",
  "PluggnB",
  "Rage",
  "Southern Hip-Hop",
  "West Coast Hip-Hop",
  "Memphis Rap",
  "Phonk",
  "Latin Trap",
  "UK Garage",
  "Grime",
  "Afrobeats",
  "Afrobeat",
  "Afropop",
  "Amapiano",
  "Afro House",
  "Gqom",
  "Highlife",
  "Dancehall",
  "Reggaeton",
  "Dembow",
  "Latin Pop",
  "Latin Rock",
  "Bachata",
  "Salsa",
  "Merengue",
  "Soca",
  "Kompa",
  "Zouk",
  "Reggae Fusion",
  "Dub",
  "Bossa Nova",
  "Samba",
  "Brazilian Funk",
  "Corridos",
  "Regional Mexican",
  "Neo-Soul",
  "Alternative R&B",
  "Contemporary R&B",
  "New Jack Swing",
  "Gospel",
  "Deep House",
  "Tech House",
  "Progressive House",
  "Minimal House",
  "Trance",
  "Drum & Bass",
  "Jungle",
