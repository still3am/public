{
  "name": "Album",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "cover_art_url": {
      "type": "string",
      "default": ""
    },
    "creator_id": {
      "type": "string"
    },
    "artisan": {
      "type": "string",
      "default": ""
    },
    "genre": {
      "type": "string",
      "enum": [
        "Pop",
        "Hip-Hop",
        "Electronic",
        "Rock",
        "R&B",
        "Jazz",
        "Classical",
        "Ambient",
        "Experimental",
        "Dance",
        "Indie",
        "Folk",
        "Country",
        "Metal",
        "Punk",
        "Lo-Fi",
        "Soul",
        "Funk",
        "Techno",
        "House",
        "Trap",
        "Latin",
        "Reggae",
        "World",
        "Other"
      ],
      "default": "Other"
    },
    "description": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "title",
    "creator_id"
  ]
}