{
  "name": "Album",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "cover_art_url": {
      "type": "string",
      "default": ""
    },
    "creator_id": {
      "type": "string"
    },
    "artisan": {
      "type": "string",
      "default": ""
    },
    "genre": {
      "type": "string",
      "enum": [
  "Pop",
  "Hip-Hop",
  "R&B",
  "Soul",
  "Funk",
  "Dance",
  "Electronic",
  "Techno",
  "House",
