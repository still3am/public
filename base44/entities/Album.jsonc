  "Downtempo",
  "Trip-Hop",
  "Lo-Fi",
  "Lo-Fi Hip-Hop",
  "Chillout",
  "Hardstyle",
  "Hyperpop",
  "Dance-Pop",
  "Indie Pop",
  "Synth-Pop",
  "Afro Swing",
  "Indie Rock",
  "Alternative Rock",
  "Hard Rock",
  "Pop Punk",
  "Post-Punk",
  "Emo",
  "Shoegaze",
  "Dream Pop",
  "Grunge",
  "Post-Rock",
  "Metalcore",
  "Death Metal",
  "Heavy Metal",
  "Acoustic",
  "Americana",
  "Bluegrass",
