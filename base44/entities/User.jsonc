{
  "name": "User",
  "type": "object",
  "properties": {
    "avatar_video_url": {
      "type": "string",
      "default": "",
      "maxLength": 4096,
      "description": "Uploaded profile motion source; poster is stored in the existing image field.",
      "rls": {
        "write": false
      }
    },
    "avatar_gif_url": {
      "type": "string",
      "default": "",
      "maxLength": 4096,
      "description": "Uploaded profile motion source; poster is stored in the existing image field.",
      "rls": {
        "write": false
      }
    },
    "banner_video_url": {
      "type": "string",
      "default": "",
      "maxLength": 4096,
      "description": "Uploaded profile motion source; poster is stored in the existing image field.",
      "rls": {
        "write": false
      }
    },
    "banner_gif_url": {
      "type": "string",
      "default": "",
      "maxLength": 4096,
      "description": "Uploaded profile motion source; poster is stored in the existing image field.",
      "rls": {
        "write": false
      }
    },
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "When true, the user is blocked from the platform",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "display_name": {
      "type": "string",
      "default": "",
      "description": "User-chosen display name shown across the app; falls back to full_name when empty",
      "rls": {
        "write": false
      }
    },
    "bio": {
      "type": "string",
      "default": "",
      "description": "Profile bio text",
      "rls": {
        "write": false
      }
    },
    "avatar_url": {
      "type": "string",
      "default": "",
      "description": "Profile avatar image URL",
      "rls": {
        "write": false
      }
    },
    "banner_use_default": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": true
      }
    },
    "banner_mobile_url": {
      "type": "string",
      "default": "",
      "rls": {
        "write": false
      }
    },
    "top_tracks_label": {
      "type": "string",
      "maxLength": 40,
      "default": "",
      "rls": {
        "write": false
      }
    },
    "banner_url": {
      "type": "string",
      "default": "",
      "description": "Profile banner image URL",
      "rls": {
        "write": false
      }
    },
    "location": {
      "type": "string",
      "default": "",
      "description": "User location",
      "rls": {
        "write": false
      }
    },
    "pronouns": {
      "type": "string",
      "default": "",
      "description": "User pronouns",
      "rls": {
        "write": false
      }
    },
    "website": {
      "type": "string",
      "default": "",
      "description": "User personal website URL",
      "rls": {
        "write": false
      }
    },
    "instagram": {
      "type": "string",
      "default": "",
      "description": "Instagram handle or URL",
      "rls": {
        "write": false
      }
    },
    "twitter": {
      "type": "string",
      "default": "",
      "description": "Twitter / X handle or URL",
      "rls": {
        "write": false
      }
    },
    "soundcloud": {
      "type": "string",
      "default": "",
      "description": "SoundCloud handle or URL",
      "rls": {
        "write": false
      }
    },
    "status_message": {
      "type": "string",
      "default": "",
      "description": "Short status / mood message displayed on the profile",
      "rls": {
        "write": false
      }
    },
    "featured_track_id": {
      "type": "string",
      "default": "",
      "description": "Track id pinned as the profile song visitors can play",
      "rls": {
        "write": true
      },
      "maxLength": 100
    },
    "top_track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Up to 8 track ids pinned to the profile as the user's Top 8",
      "rls": {
        "write": true
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "is_artist": {
      "type": "boolean",
      "default": false,
      "description": "Self-selected artist mode for regular users; never grants administrator access.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "user"
          }
        }
      }
    },
    "show_explicit": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": true
      }
    },
    "adult_confirmed": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": true
      }
    },
    "offline_track_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "default": [],
      "description": "Own-account offline song selections; playback is authorized separately.",
      "rls": {
        "read": {
          "data.id": "{{user.id}}"
        },
        "write": {
          "$and": [
            {
              "data.id": "{{user.id}}"
            },
            {
              "$nor": [
                {
                  "user_condition": {
                    "is_blocked": true
                  }
                },
                {
                  "user_condition": {
                    "disabled": true
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "offline_migrated": {
      "type": "boolean",
      "default": false,
      "rls": {
        "read": {
          "data.id": "{{user.id}}"
        },
        "write": {
          "$and": [
            {
              "data.id": "{{user.id}}"
            },
            {
              "$nor": [
                {
                  "user_condition": {
                    "is_blocked": true
                  }
                },
                {
                  "user_condition": {
                    "disabled": true
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this member finished or skipped the first-time welcome",
      "rls": {
        "write": true
      }
    },
    "profile_background_mode": {
      "type": "string",
      "enum": [
        "auto",
        "custom",
        "off"
      ],
      "default": "auto",
      "rls": {
        "write": true
      }
    },
    "profile_background_motion": {
      "type": "string",
      "enum": [
        "flow",
        "still"
      ],
      "default": "flow",
      "rls": {
        "write": true
      }
    },
    "profile_background_speed": {
      "type": "number",
      "minimum": 0.35,
      "maximum": 1.6,
      "default": 1,
      "rls": {
        "write": true
      }
    },
    "profile_background_colors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "default": [],
      "description": "Up to three hex colors selected from profile song artwork",
      "rls": {
        "write": true
      },
      "maxItems": 3
    },
    "username": {
      "type": "string",
      "default": "",
      "maxLength": 24,
      "pattern": "^$|^[a-z0-9_]{3,24}$",
      "description": "Public lowercase handle, checked for availability by the profile gateway",
      "rls": {
        "write": false
      }
    },
    "avatar_preset": {
      "type": "string",
      "enum": [
        "",
        "initials",
        "/avatars/antisocial.webp",
        "/avatars/flower-boy.webp",
        "/avatars/good-day.webp",
        "/avatars/currents.webp",
        "/avatars/underwater.webp",
        "/avatars/acid-rap.webp",
        "/avatars/crown.webp",
        "/avatars/sky-room.webp",
        "/avatars/pink-blue.webp",
        "/avatars/blond.webp",
        "/avatars/yeat.webp",
        "/avatars/happier-than-ever.webp",
        "/avatars/genesis.webp",
        "/avatars/eternal-atake.webp",
        "/avatars/cigarettes-after-sex.webp",
        "/avatars/pills-and-flowers.webp",
        "/avatars/chromakopia.webp",
        "/avatars/born-to-die.webp",
        "/avatars/ye-mountains.webp",
        "/avatars/bandage.webp",
        "/avatars/olive-shadows.webp",
        "/avatars/desert-palms.webp",
        "/avatars/halo-horns.webp",
        "/avatars/monochrome-plaid.webp",
        "/avatars/red-portrait.webp",
        "/avatars/rose-silhouette.webp",
        "/avatars/stoney.webp",
        "/avatars/whole-lotta-red.webp",
        "/avatars/butterfly-lavender.webp",
        "/avatars/damn.webp",
        "/avatars/starboy.webp",
        "/avatars/blue-horns.webp",
        "/avatars/drip-harder.webp",
        "/avatars/liberty-coin.webp",
        "/avatars/disco-mirror.webp",
        "/avatars/storm-radar.webp",
        "/avatars/drive-through.webp",
        "/avatars/hello-kitty.webp",
        "/avatars/heart-eyes.webp",
        "/avatars/camo.webp",
        "/avatars/grass-roots.webp",
        "/avatars/cloud-nine.webp",
        "/avatars/blue-code.webp",
        "/avatars/silver-thorns.webp",
        "/avatars/midnight-thorns.webp",
        "/avatars/love-jesus.webp"
      ],
      "default": "",
      "description": "Preinstalled gallery choice only. External uploads remain in avatar_url.",
      "rls": {
        "write": true
      }
    }
  },
  "required": []
}