{
  "name": "User",
  "type": "object",
  "properties": {
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "When true, the user is blocked from the platform",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "display_name": {
      "type": "string",
      "default": "",
      "description": "User-chosen display name shown across the app; falls back to full_name when empty",
      "rls": {
        "write": false
      }
    },
    "bio": {
      "type": "string",
      "default": "",
      "description": "Profile bio text",
      "rls": {
        "write": false
      }
    },
    "avatar_url": {
      "type": "string",
      "default": "",
      "description": "Profile avatar image URL",
      "rls": {
        "write": false
      }
    },
    "banner_url": {
      "type": "string",
      "default": "",
      "description": "Profile banner image URL",
      "rls": {
        "write": false
      }
    },
    "location": {
      "type": "string",
      "default": "",
      "description": "User location",
      "rls": {
        "write": false
      }
    },
    "pronouns": {
      "type": "string",
      "default": "",
      "description": "User pronouns",
      "rls": {
        "write": false
      }
    },
    "website": {
      "type": "string",
      "default": "",
      "description": "User personal website URL",
      "rls": {
        "write": false
      }
    },
    "instagram": {
      "type": "string",
      "default": "",
      "description": "Instagram handle or URL",
      "rls": {
        "write": false
      }
    },
    "twitter": {
      "type": "string",
      "default": "",
      "description": "Twitter / X handle or URL",
      "rls": {
        "write": false
      }
    },
    "soundcloud": {
      "type": "string",
      "default": "",
      "description": "SoundCloud handle or URL",
      "rls": {
        "write": false
      }
    },
    "status_message": {
      "type": "string",
      "default": "",
      "description": "Short status / mood message displayed on the profile",
      "rls": {
        "write": false
      }
    },
    "featured_track_id": {
      "type": "string",
      "default": "",
      "description": "Track id pinned as the profile song visitors can play",
      "rls": {
        "write": true
      },
      "maxLength": 100
    },
    "top_track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Up to 8 track ids pinned to the profile as the user's Top 8",
      "rls": {
        "write": false
      }
    },
    "is_artist": {
      "type": "boolean",
      "default": false,
      "description": "When true, the user is marked as an artist and gets access to artist tools and an artist badge on their profile",
      "rls": {
        "write": false
      }
    },
    "show_explicit": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "adult_confirmed": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "offline_track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "rls": {
        "read": false,
        "write": false
      }
    },
    "offline_migrated": {
      "type": "boolean",
      "default": false,
      "rls": {
        "read": false,
        "write": false
      }
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this member finished or skipped the first-time welcome",
      "rls": {
        "write": true
      }
    },
    "profile_background_mode": {
      "type": "string",
      "enum": [
        "auto",
        "custom",
        "off"
      ],
      "default": "auto",
      "rls": {
        "write": true
      }
    },
    "profile_background_motion": {
      "type": "string",
      "enum": [
        "flow",
        "still"
      ],
      "default": "flow",
      "rls": {
        "write": true
      }
    },
    "profile_background_speed": {
      "type": "number",
      "minimum": 0.35,
      "maximum": 1.6,
      "default": 1,
      "rls": {
        "write": true
      }
    },
    "profile_background_colors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "default": [],
      "description": "Up to three hex colors selected from profile song artwork",
      "rls": {
        "write": true
      },
      "maxItems": 3
    }
  },
  "required": []
}