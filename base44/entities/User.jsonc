      "type": "string",
      "default": ""
    },
    "bio": {
      "type": "string",
      "default": ""
    },
    "can_upload": {
      "type": "boolean",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "follower_count": {
      "type": "integer",
      "default": 0
    },
    "following_count": {
      "type": "integer",
      "default": 0
