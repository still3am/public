{
  "name": "ListeningSession",
  "type": "object",
  "properties": {
    "session_key": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "listened_seconds": {
      "type": "number",
      "minimum": 0,
      "default": 0
    }
  },
  "required": [
    "session_key",
    "track_id",
    "started_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}