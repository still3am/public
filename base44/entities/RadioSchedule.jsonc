{
  "name": "RadioSchedule",
  "type": "object",
  "properties": {
    "day_key": {
      "type": "string"
    },
    "anchor_ms": {
      "type": "number"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "day_key",
    "anchor_ms",
    "entries"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}