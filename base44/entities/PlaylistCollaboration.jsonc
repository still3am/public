{
  "name": "PlaylistCollaboration",
  "type": "object",
  "properties": {
    "playlist_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "track_contributors": {
      "type": "object",
      "default": {}
    }
  },
  "required": [
    "playlist_id",
    "owner_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.member_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}