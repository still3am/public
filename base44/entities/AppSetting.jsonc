{
  "name": "AppSetting",
  "type": "object",
  "properties": {
    "uploads_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Global kill switch \u2014 when false, non-admin users cannot upload tracks"
    },
    "banner_messages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Custom scrolling banner messages; empty array falls back to defaults"
    },
    "catalog_count": {
      "type": "integer",
      "default": 0,
      "description": "Last measured number of published tracks, shared by every user so the catalog is only re-counted hourly"
    },
    "catalog_counted_at": {
      "type": "string",
      "default": "",
      "description": "ISO timestamp of when catalog_count was measured"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}