{
  "name": "Lyrics",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string"
    },
    "uploader_id": {
      "type": "string"
    },
    "language_code": {
      "type": "string",
      "default": "en"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "start_time_ms": {
            "type": "integer",
            "default": 0
          },
          "end_time_ms": {
            "type": "integer",
            "default": 0
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "start_time_ms": {
                  "type": "integer"
                },
                "end_time_ms": {
                  "type": "integer"
                }
              },
              "required": [
                "text",
                "start_time_ms",
                "end_time_ms"
              ]
            }
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved"
      ],
      "default": "pending"
    },
    "out_of_sync": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "track_id",
    "uploader_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
