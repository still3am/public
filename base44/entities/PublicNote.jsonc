{
  "name": "PublicNote",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "appearance": {
      "type": "string",
      "enum": [
        "classic",
        "cover_flow"
      ],
      "default": "classic"
    },
    "caption": {
      "type": "string",
      "maxLength": 80,
      "default": ""
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}