{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "cover_art_url": {
      "type": "string",
      "default": ""
    },
    "creator_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_public": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "creator_id"
  ]
}