{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "cover_art_url": {
      "type": "string",
      "default": "",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "creator_id": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "default": "",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "rls": {
        "read": true,
        "write": {
          "$and": [
            {
              "$or": [
                {
                  "data.creator_id": "{{user.id}}"
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            },
            {
              "$nor": [
                {
                  "user_condition": {
                    "is_blocked": true
                  }
                },
                {
                  "user_condition": {
                    "disabled": true
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "creator_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "data.creator_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
