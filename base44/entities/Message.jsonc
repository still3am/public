{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string",
      "default": ""
    },
    "recipient_id": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string"
    },
    "track_id": {
      "type": "string",
      "default": "",
      "description": "Optional track shared inside the message"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "sender_id",
    "recipient_id",
    "body"
  ],
  "rls": {
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.recipient_id": "{{user.id}}"
    },
    "delete": {
      "data.sender_id": "{{user.id}}"
    }
  }
}