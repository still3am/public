{
  "name": "GallerySubmission",
  "type": "object",
  "properties": {
    "uploader_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "avatar",
        "banner"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    }
  },
  "required": [
    "uploader_id",
    "name",
    "url",
    "kind",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "data.status": "approved"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
