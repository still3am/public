{
  "name": "TrackAnnotation",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string",
      "default": ""
    },
    "author_avatar_url": {
      "type": "string",
      "default": ""
    },
    "timestamp_ms": {
      "type": "integer",
      "default": 0,
      "description": "Playback position the note is pinned to"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "track_id",
    "author_id",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
