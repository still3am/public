{
  "name": "CatalogLyrics",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "LRCLIB"
      ]
    },
    "source_id": {
      "type": "integer"
    },
    "synced_lyrics": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    }
  },
  "required": [
    "track_id",
    "fingerprint",
    "source",
    "source_id",
    "synced_lyrics",
    "duration_seconds"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}