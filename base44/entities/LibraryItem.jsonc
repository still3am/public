{
  "name": "LibraryItem",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "folder": {
      "type": "string",
      "default": ""
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "user_id",
    "track_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}