{
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "full_name": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "avatar_url": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "banner_url": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "bio": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "location": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "pronouns": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "website": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "instagram": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "twitter": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "soundcloud": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status_message": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "public_song_note": {
      "type": "object",
      "description": "Native song-only note state. Contains no user-authored text.",
      "properties": {
        "emoji": {
          "type": "string",
          "enum": [
            "",
            "\ud83d\ude04",
            "\ud83d\ude0a",
            "\ud83d\ude02",
            "\ud83e\udd23",
            "\ud83e\udd79",
            "\ud83e\udd72",
            "\ud83e\udd70",
            "\ud83d\ude0d",
            "\ud83d\ude0e",
            "\ud83e\udd14",
            "\ud83d\ude43",
            "\ud83d\ude34",
            "\ud83e\udd71",
            "\ud83d\ude2d",
            "\ud83d\ude2e\u200d\ud83d\udca8",
            "\ud83e\udee0",
            "\ud83d\ude36\u200d\ud83c\udf2b\ufe0f",
            "\ud83d\udc40",
            "\ud83e\udd0d",
            "\u2764\ufe0f",
            "\ud83d\udc9c",
            "\ud83d\udc99",
            "\ud83d\udda4",
            "\ud83d\udc9a",
            "\ud83d\udc9b",
            "\ud83e\udde1",
            "\ud83d\udc94",
            "\u2728",
            "\u2b50",
            "\ud83c\udf19",
            "\u2600\ufe0f",
            "\ud83c\udf27\ufe0f",
            "\ud83c\udf08",
            "\ud83d\udd25",
            "\u26a1",
            "\ud83c\udf0a",
            "\ud83c\udf38",
            "\ud83c\udfa7",
            "\ud83c\udfb5",
            "\ud83c\udfb6",
            "\ud83c\udfa4",
            "\ud83c\udfb8",
            "\ud83c\udfb9",
            "\ud83e\udd41",
            "\ud83d\udc83",
            "\ud83d\udd7a",
            "\ud83e\udea9",
            "\ud83d\ude80",
            "\ud83d\udcaf",
            "\ud83d\ude4c",
            "\ud83d\udc4f",
            "\ud83e\udd1d",
            "\ud83e\udef6",
            "\ud83e\udd1e",
            "\ud83d\ude4f",
            "\ud83c\udf89",
            "\u2705"
          ],
          "default": ""
        },
        "appearance": {
          "type": "string",
          "enum": [
            "classic",
            "cover_flow"
          ],
          "default": "classic"
        },
        "mode": {
          "type": "string",
          "enum": [
            "song",
            "server",
            "none"
          ]
        },
        "track_id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^$|^[a-zA-Z0-9_-]+$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "track_id",
        "expires_at"
      ],
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "featured_track_id": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "profile_background_mode": {
      "type": "string",
      "default": "auto",
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "enum": [
        "auto",
        "custom",
        "off"
      ]
    },
    "profile_background_motion": {
      "type": "string",
      "enum": [
        "flow",
        "still"
      ],
      "default": "flow",
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "profile_background_speed": {
      "type": "number",
      "minimum": 0.35,
      "maximum": 1.6,
      "default": 1,
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "profile_background_colors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "default": [],
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "maxItems": 3
    },
    "top_track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_public_admin": {
      "type": "boolean",
      "default": false,
      "description": "Public admin badge, derived only from the account role by trusted server code",
      "rls": {
        "write": false
      }
    },
    "is_artist": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$and": [
                {
                  "data.user_id": "{{user.id}}"
                },
                {
                  "user_condition": {
                    "role": "user"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "user_id": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "joined_at": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "rls": {
        "write": false
      }
    },
    "username": {
      "type": "string",
      "default": "",
      "maxLength": 24,
      "pattern": "^$|^[a-z0-9_]{3,24}$",
      "description": "Public lowercase handle, checked for availability by the profile gateway",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "data.visible": true
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "PublicProfile"
}