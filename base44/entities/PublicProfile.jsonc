        "track_id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "country",
        "track_id",
        "expires_at"
      ],
      "additionalProperties": false,
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "data.visible": true
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "PublicProfile"
}