{
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "full_name": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "avatar_url": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "banner_url": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "bio": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "location": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "pronouns": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "website": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "instagram": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "twitter": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "soundcloud": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status_message": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "public_song_note": {
      "type": "object",
      "description": "Native song-only note state. Contains no user-authored text.",
      "properties": {
        "appearance": {
          "type": "string",
          "enum": [
            "classic",
            "cover_flow"
          ],
          "default": "classic"
        },
        "mode": {
          "type": "string",
          "enum": [
            "song",
            "server",
            "none"
          ]
        },
        "track_id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^$|^[a-zA-Z0-9_-]+$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "track_id",
        "expires_at"
      ],
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "featured_track_id": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "profile_background_mode": {
      "type": "string",
      "default": "auto",
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "enum": [
        "auto",
        "custom",
        "off"
      ]
    },
    "profile_background_motion": {
      "type": "string",
      "enum": [
        "flow",
        "still"
      ],
      "default": "flow",
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "profile_background_speed": {
      "type": "number",
      "minimum": 0.35,
      "maximum": 1.6,
      "default": 1,
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "profile_background_colors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "default": [],
      "rls": {
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "maxItems": 3
    },
    "top_track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_public_admin": {
      "type": "boolean",
      "default": false,
      "description": "Public admin badge, derived only from the account role by trusted server code",
      "rls": {
        "write": false
      }
    },
    "is_artist": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$and": [
                {
                  "data.user_id": "{{user.id}}"
                },
                {
                  "user_condition": {
                    "role": "user"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "user_id": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "joined_at": {
      "type": "string",
      "default": "",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "rls": {
        "write": false
      }
    },
    "username": {
      "type": "string",
      "default": "",
      "maxLength": 24,
      "pattern": "^$|^[a-z0-9_]{3,24}$",
      "description": "Public lowercase handle, checked for availability by the profile gateway",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "data.visible": true
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "PublicProfile"
}