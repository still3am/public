{
  "name": "ProfileComment",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "User id of the profile receiving the comment"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string",
      "default": ""
    },
    "author_avatar_url": {
      "type": "string",
      "default": ""
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "author_id",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
