{
  "name": "ErrorReport",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string",
      "default": "",
      "description": "Display name of whoever filed the report, so admins can read it without a lookup"
    },
    "message": {
      "type": "string",
      "description": "What the user says went wrong"
    },
    "details": {
      "type": "string",
      "default": "",
      "description": "Automatically captured error text from the moment before the report was filed"
    },
    "page_path": {
      "type": "string",
      "default": "",
      "description": "Page the user was on when it broke"
    },
    "device": {
      "type": "string",
      "default": "",
      "description": "Browser, platform and viewport width"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved"
      ],
      "default": "open"
    }
  },
  "required": [
    "user_id",
    "message"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}