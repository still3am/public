{
  "name": "Like",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "track_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}