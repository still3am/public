{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "cover_art_url": {
      "type": "string",
      "default": ""
    },
    "uploader_id": {
      "type": "string"
    },
    "uploader_name": {
      "type": "string",
      "default": ""
    },
    "uploader_avatar_url": {
      "type": "string",
      "default": ""
    },
    "artist": {
      "type": "string",
      "default": ""
    },
    "album_id": {
      "type": "string",
      "default": ""
    },
    "track_number": {
      "type": "integer",
      "default": 0
    },
    "genre": {
      "type": "string",
      "enum": [
        "Pop",
        "Hip-Hop",
        "R&B",
        "Soul",
        "Funk",
        "Dance",
        "Electronic",
        "Techno",
        "House",
        "Trap",
        "Disco",
        "Rock",
        "Alternative",
        "Indie",
        "Punk",
        "Metal",
        "Country",
        "Folk",
        "Blues",
        "Jazz",
        "Classical",
        "Ambient",
        "Reggae",
        "Latin",
        "World",
        "K-Pop",
        "J-Pop",
        "Singer/Songwriter",
        "Soundtrack",
        "Easy Listening",
        "Holiday",
        "Christian & Gospel",
        "Children's Music",
        "Comedy",
        "Spoken Word",
        "Fitness & Workout",
        "Other"
      ],
      "default": "Other"
    },
    "play_count": {
      "type": "integer",
      "default": 0
    },
    "like_count": {
      "type": "integer",
      "default": 0
    },
    "duration_seconds": {
      "type": "integer",
      "default": 0
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "lyrics_text": {
      "type": "string",
      "default": ""
    },
    "explicit": {
      "type": "boolean",
      "default": false
    },
    "rights_confirmed": {
      "type": "boolean",
      "default": false
    },
    "is_downloadable": {
      "type": "boolean",
      "default": false
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "private"
      ],
      "default": "pending",
      "description": "Approval gate: pending = awaiting admin review, approved = live on PUBLIC, rejected = declined, private = library-only (never public)"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "True only once an admin approves the track for public release"
    }
  },
  "required": [
    "title",
    "audio_url",
    "uploader_id",
    "genre"
  ],
  "rls": {
    "create": {
      "data.uploader_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}