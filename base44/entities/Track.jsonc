{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "cover_art_url": {
      "type": "string",
      "default": ""
    },
    "uploader_id": {
      "type": "string"
    },
    "uploader_name": {
      "type": "string",
      "default": ""
    },
    "uploader_avatar_url": {
      "type": "string",
      "default": ""
    },
    "artist": {
      "type": "string",
      "default": ""
    },
    "album_id": {
      "type": "string",
      "default": ""
    },
    "track_number": {
      "type": "integer",
      "default": 0
    },
    "genre": {
      "type": "string",
      "enum": [
        "Pop",
        "Hip-Hop",
        "Electronic",
        "Rock",
        "R&B",
        "Jazz",
        "Classical",
        "Ambient",
        "Experimental",
        "Dance",
        "Indie",
        "Folk",
        "Country",
        "Metal",
        "Punk",
        "Lo-Fi",
        "Soul",
        "Funk",
        "Techno",
        "House",
        "Trap",
        "Latin",
        "Reggae",
        "World",
        "Other",
        "Afro-Pop",
        "Amapiano",
        "Afrobeats",
        "K-Pop",
        "J-Pop",
        "Bollywood",
        "Reggaeton",
        "Dancehall",
        "Drill",
        "Phonk",
        "Hyperpop",
        "Drum & Bass",
        "Trance",
        "Disco",
        "Synthwave",
        "Vaporwave",
        "Jersey Club",
        "Bossa Nova",
        "Gospel",
        "Chill",
        "Garage",
        "Hardcore",
        "Bedroom Pop",
        "Pop Punk",
        "Worship",
        "Sexy Drill",
        "UK Drill",
        "Brooklyn Drill",
        "Chicago Drill",
        "NY Drill",
        "Arabic Drill",
        "Afro Drill",
        "Gengetone",
        "Alt\u00e9",
        "Gqom",
        "3-Step",
        "Singeli",
        "Bongo Flava",
        "Maskandi",
        "Afrosoul",
        "Baile Funk",
        "Funk Carioca",
        "Cumbia",
        "Bachata",
        "Merengue",
        "Salsa",
        "Sertanejo",
        "Forr\u00f3",
        "Tango",
        "Bolero",
        "Mariachi",
        "Ranchera",
        "Latin Pop",
        "Latin Trap",
        "Urbano",
        "City Pop",
        "C-Pop",
        "T-Pop",
        "Mandopop",
        "Pinoy Pop",
        "Punjabi",
        "Tamil",
        "Bhangra",
        "Dangdut",
        "Dream Pop",
        "Shoegaze",
        "Post-Punk",
        "Emo",
        "Ska",
        "Grunge",
        "J-Rock",
        "K-Rock",
        "Neo-Soul",
        "Crunk",
        "Memphis Rap",
        "Cloud Rap",
        "Trap Metal",
        "Slowed & Reverb",
        "Sped Up",
        "Zouk",
        "Kompa",
        "Kizomba",
        "Fado",
        "Arabic Pop",
        "Persian Pop",
        "Turkish Pop"
      ],
      "default": "Other"
    },
    "play_count": {
      "type": "integer",
      "default": 0
    },
    "like_count": {
      "type": "integer",
      "default": 0
    },
    "duration_seconds": {
      "type": "integer",
      "default": 0
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "lyrics_text": {
      "type": "string",
      "default": ""
    },
    "explicit": {
      "type": "boolean",
      "default": false
    },
    "rights_confirmed": {
      "type": "boolean",
      "default": false
    },
    "is_downloadable": {
      "type": "boolean",
      "default": false
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "private"
      ],
      "default": "pending",
      "description": "Approval gate: pending = awaiting admin review, approved = live on PUBLIC, rejected = declined, private = library-only (never public)"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "True only once an admin approves the track for public release"
    }
  },
  "required": [
    "title",
    "audio_url",
    "uploader_id",
    "genre"
  ],
  "rls": {
    "create": {
      "data.uploader_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}