{
  "name": "Track",
  "type": "object",
  "properties": {
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "First approved publication time for release notifications",
      "rls": {
        "read": true,
        "write": false
      }
    },
    "title": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "cover_art_url": {
      "type": "string",
      "default": ""
    },
    "uploader_id": {
      "type": "string"
    },
    "uploader_name": {
      "type": "string",
      "default": ""
    },
    "uploader_avatar_url": {
      "type": "string",
      "default": ""
    },
    "artist": {
      "type": "string",
      "default": ""
    },
    "album_name": {
      "type": "string",
      "default": ""
    },
    "album_artist": {
      "type": "string",
      "default": ""
    },
    "disc_number": {
      "type": "integer",
      "default": 0
    },
    "release_year": {
      "type": "integer",
      "default": 0
    },
    "album_id": {
      "type": "string",
      "default": ""
    },
    "track_number": {
      "type": "integer",
      "default": 0
    },
    "genre": {
      "type": "string",
      "enum": [
        "Pop",
        "Hip-Hop",
        "R&B",
        "Soul",
        "Funk",
        "Dance",
        "Electronic",
        "Techno",
        "House",
        "Trap",
        "Disco",
        "Rock",
        "Alternative",
        "Indie",
        "Punk",
        "Metal",
        "Country",
        "Folk",
        "Blues",
        "Jazz",
        "Classical",
        "Ambient",
        "Reggae",
        "Latin",
        "World",
        "K-Pop",
        "J-Pop",
        "Singer/Songwriter",
        "Soundtrack",
        "Easy Listening",
        "Holiday",
        "Christian & Gospel",
        "Children's Music",
        "Comedy",
        "Spoken Word",
        "Fitness & Workout",
        "Sexy Drill",
        "Drill",
        "New York Drill",
        "Brooklyn Drill",
        "UK Drill",
        "Chicago Drill",
        "Sample Drill",
        "Jersey Club",
        "Baltimore Club",
        "Philly Club",
        "Rap",
        "Boom Bap",
        "Alternative Hip-Hop",
        "Conscious Hip-Hop",
        "Cloud Rap",
        "Emo Rap",
        "PluggnB",
        "Rage",
        "Southern Hip-Hop",
        "West Coast Hip-Hop",
        "Memphis Rap",
        "Phonk",
        "Latin Trap",
        "UK Garage",
        "Grime",
        "Afrobeats",
        "Afrobeat",
        "Afropop",
        "Amapiano",
        "Afro House",
        "Gqom",
        "Highlife",
        "Dancehall",
        "Reggaeton",
        "Dembow",
        "Latin Pop",
        "Latin Rock",
        "Bachata",
        "Salsa",
        "Merengue",
        "Soca",
        "Kompa",
        "Zouk",
        "Reggae Fusion",
        "Dub",
        "Bossa Nova",
        "Samba",
        "Brazilian Funk",
        "Corridos",
        "Regional Mexican",
        "Neo-Soul",
        "Alternative R&B",
        "Contemporary R&B",
        "New Jack Swing",
        "Gospel",
        "Deep House",
        "Tech House",
        "Progressive House",
        "Minimal House",
        "Trance",
        "Drum & Bass",
        "Jungle",
        "Dubstep",
        "Bass",
        "Breakbeat",
        "Electro",
        "IDM",
        "Synthwave",
        "Downtempo",
        "Trip-Hop",
        "Lo-Fi",
        "Lo-Fi Hip-Hop",
        "Chillout",
        "Hardstyle",
        "Hyperpop",
        "Dance-Pop",
        "Indie Pop",
        "Synth-Pop",
        "Afro Swing",
        "Indie Rock",
        "Alternative Rock",
        "Hard Rock",
        "Pop Punk",
        "Post-Punk",
        "Emo",
        "Shoegaze",
        "Dream Pop",
        "Grunge",
        "Post-Rock",
        "Metalcore",
        "Death Metal",
        "Heavy Metal",
        "Acoustic",
        "Americana",
        "Bluegrass",
        "Contemporary Country",
        "Smooth Jazz",
        "Jazz Fusion",
        "Jazz Rap",
        "Bebop",
        "Experimental",
        "Instrumental",
        "Orchestral",
        "Opera",
        "New Age",
        "Meditation",
        "Bollywood",
        "Desi Hip-Hop",
        "Bhangra",
        "K-R&B",
        "K-Hip-Hop",
        "J-Rock",
        "Other"
      ],
      "default": "Other"
    },
    "play_count": {
      "type": "integer",
      "default": 0
    },
    "like_count": {
      "type": "integer",
      "default": 0
    },
    "duration_seconds": {
      "type": "integer",
      "default": 0
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "lyrics_text": {
      "type": "string",
      "default": ""
    },
    "explicit": {
      "type": "boolean",
      "default": false
    },
    "rights_confirmed": {
      "type": "boolean",
      "default": false
    },
    "is_downloadable": {
      "type": "boolean",
      "default": false
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "private"
      ],
      "default": "pending",
      "description": "Approval gate: pending = awaiting admin review, approved = live on PUBLIC, rejected = declined, private = library-only (never public)"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "True only once an admin approves the track for public release"
    },
    "rights_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "audio_file_uri": {
      "type": "string",
      "default": "",
      "rls": {
        "read": {
          "$or": [
            {
              "data.uploader_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "music_video_file_uri": {
      "type": "string",
      "default": "",
      "description": "Private music-video attachment; playback URLs are generated after track access checks.",
      "rls": {
        "read": {
          "$or": [
            {
              "data.uploader_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "music_video_rights_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "audio_sha256": {
      "type": "string",
      "default": "",
      "description": "SHA-256 of uploaded file bytes; not an acoustic fingerprint",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "upload_request_id": {
      "type": "string",
      "default": "",
      "rls": {
        "read": {
          "$or": [
            {
              "data.uploader_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "audio_url",
    "uploader_id",
    "genre"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.is_published": true
            },
            {
              "data.approval_status": "approved"
            }
          ]
        },
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}