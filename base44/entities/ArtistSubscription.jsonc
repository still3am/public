{
  "name": "ArtistSubscription",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string",
      "maxLength": 200
    },
    "artist_key": {
      "type": "string",
      "maxLength": 200
    },
    "read_track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "artist_name",
    "artist_key"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}