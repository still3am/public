{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "new_follower",
        "new_upload_from_followed",
        "track_liked",
        "profile_comment",
        "track_shared",
        "suggestion_shipped",
        "support_reply"
      ],
      "default": "track_liked",
      "rls": {
        "write": false
      }
    },
    "actor_id": {
      "type": "string",
      "default": "",
      "rls": {
        "write": false
      }
    },
    "actor_name": {
      "type": "string",
      "default": "",
      "description": "Verified sender display name saved when the notification is created",
      "rls": {
        "write": false
      }
    },
    "actor_avatar_url": {
      "type": "string",
      "default": "",
      "rls": {
        "write": false
      }
    },
    "track_id": {
      "type": "string",
      "default": "",
      "rls": {
        "write": false
      }
    },
    "comment": {
      "type": "string",
      "default": "",
      "description": "Optional note the sender attached when sharing a track",
      "rls": {
        "write": false
      }
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "source_key": {
      "type": "string",
      "default": "",
      "rls": {
        "write": false
      }
    },
    "target_path": {
      "type": "string",
      "default": "",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "user_id",
    "type",
    "actor_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}