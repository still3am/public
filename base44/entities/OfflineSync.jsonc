{
  "name": "OfflineSync",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "tracks": {
      "type": "string",
      "default": "",
      "description": "JSON-serialized array of minimal track objects the user has saved for offline, synced across their devices so each device can auto-download the same songs"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}