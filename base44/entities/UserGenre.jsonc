{
  "name": "UserGenre",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Genres the user picked during onboarding \u2014 used to personalize Discover and auto-queue"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "is_blocked": false
          }
        }
      ]
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "is_blocked": false
          }
        }
      ]
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
