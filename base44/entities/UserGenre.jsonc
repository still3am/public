{
  "name": "UserGenre",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Genres the user picked during onboarding \u2014 used to personalize Discover and auto-queue"
    },
    "favorite_track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "default": []
    },
    "favorite_artists": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 5,
      "default": []
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$nor": [
            {
              "user_condition": {
                "is_blocked": true
              }
            },
            {
              "user_condition": {
                "disabled": true
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
